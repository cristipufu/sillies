diff --git a/Sources/SilliesCore/ConversationPolicy.swift b/Sources/SilliesCore/ConversationPolicy.swift
new file mode 100644
index 0000000..25b84b1
--- /dev/null
+++ b/Sources/SilliesCore/ConversationPolicy.swift
@@ -0,0 +1,38 @@
+/// Application policy, supplied by the selected backend. Byte limits remain separate transport guards.
+public struct ConversationPolicy: Codable, Equatable, Sendable {
+  public struct Compaction: Codable, Equatable, Sendable {
+    public let summaryWords: Int
+    public let headroomTokens: Int
+    public init(summaryWords: Int, headroomTokens: Int) {
+      self.summaryWords = summaryWords
+      self.headroomTokens = headroomTokens
+    }
+  }
+
+  public struct Tools: Codable, Equatable, Sendable {
+    public let maximumCalls: Int
+    public let reserveTokens: Int
+    public let resultTokens: Int
+    public init(maximumCalls: Int, reserveTokens: Int, resultTokens: Int) {
+      self.maximumCalls = maximumCalls
+      self.reserveTokens = reserveTokens
+      self.resultTokens = resultTokens
+    }
+  }
+
+  public let safetyTokens: Int
+  public let compaction: Compaction
+  public let tools: Tools
+  public init(safetyTokens: Int, compaction: Compaction, tools: Tools) {
+    self.safetyTokens = safetyTokens
+    self.compaction = compaction
+    self.tools = tools
+  }
+  public var isValid: Bool {
+    safetyTokens > 0 && compaction.summaryWords > 0 && compaction.headroomTokens >= 0
+      && tools.maximumCalls > 0 && tools.maximumCalls <= Self.maximumToolCalls
+      && tools.reserveTokens > 0 && tools.resultTokens > 0
+      && tools.resultTokens <= tools.reserveTokens
+  }
+  private static let maximumToolCalls = 32
+}
diff --git a/Sources/SilliesCore/TextGenerationProfile.swift b/Sources/SilliesCore/TextGenerationProfile.swift
new file mode 100644
index 0000000..b95fedb
--- /dev/null
+++ b/Sources/SilliesCore/TextGenerationProfile.swift
@@ -0,0 +1,40 @@
+/// Task-specific decoding settings. Reasoning capacity is accounted for by both admission and runtime.
+public struct TextGenerationProfile: Codable, Equatable, Sendable {
+  public struct Task: Codable, Equatable, Sendable {
+    public let outputTokens: Int
+    public let reasoningTokens: Int
+    public let sampling: TextModelSampling
+    public let repetitionContextTokens: Int
+    public init(
+      outputTokens: Int, reasoningTokens: Int, sampling: TextModelSampling,
+      repetitionContextTokens: Int
+    ) {
+      self.outputTokens = outputTokens
+      self.reasoningTokens = reasoningTokens
+      self.sampling = sampling
+      self.repetitionContextTokens = repetitionContextTokens
+    }
+
+    public var isValid: Bool {
+      outputTokens > 0 && reasoningTokens >= 0 && sampling.isValid
+        && repetitionContextTokens >= 0
+        && !outputTokens.addingReportingOverflow(reasoningTokens).overflow
+    }
+
+    /// A caller can ask for less output; the model's reviewed task allowance remains the ceiling.
+    public func generationTokens(for requestedOutputTokens: Int) -> Int? {
+      guard isValid, requestedOutputTokens > 0 else { return nil }
+      return min(requestedOutputTokens, outputTokens) + reasoningTokens
+    }
+  }
+
+  public let conversation: Task
+  public let summary: Task
+  public let precise: Task
+  public init(conversation: Task, summary: Task, precise: Task) {
+    self.conversation = conversation
+    self.summary = summary
+    self.precise = precise
+  }
+  public var isValid: Bool { conversation.isValid && summary.isValid && precise.isValid }
+}
diff --git a/Sources/SilliesCore/TextModelProfile.swift b/Sources/SilliesCore/TextModelProfile.swift
new file mode 100644
index 0000000..8938d81
--- /dev/null
+++ b/Sources/SilliesCore/TextModelProfile.swift
@@ -0,0 +1,45 @@
+import Foundation
+
+/// Reviewed settings for one checkpoint/runtime combination. Algorithms consume capabilities,
+/// never model names. Published capacity and the application's working set are deliberately distinct.
+public struct TextModelProfile: Codable, Equatable, Sendable {
+  public struct Context: Codable, Equatable, Sendable {
+    public let maximumTokens: Int
+    public let workingTokens: Int
+    public var isValid: Bool {
+      workingTokens > 0 && workingTokens <= maximumTokens
+    }
+  }
+
+  public struct Prefill: Codable, Equatable, Sendable {
+    /// nil preserves the runtime's model-selected chunk size, including model-specific ceilings.
+    public let chunkTokens: Int?
+    public var isValid: Bool { chunkTokens.map { $0 > 0 } ?? true }
+  }
+
+  public struct Evidence: Codable, Equatable, Sendable {
+    public let sources: [URL]
+    public let runtimeRevision: String
+    public let rationale: String
+  }
+
+  public let context: Context
+  public let prefill: Prefill
+  public let generation: TextGenerationProfile
+  public let conversation: ConversationPolicy
+  public let evidence: Evidence
+
+  public var isValid: Bool {
+    context.isValid && prefill.isValid && generation.isValid && conversation.isValid
+      && generation.conversation.outputTokens < context.workingTokens
+      && generation.summary.outputTokens < context.workingTokens
+      && conversation.safetyTokens < context.workingTokens
+      && conversation.tools.reserveTokens < context.workingTokens
+      && conversation.compaction.headroomTokens < context.workingTokens
+      && [generation.conversation, generation.summary, generation.precise].allSatisfy {
+        $0.reasoningTokens <= context.workingTokens - $0.outputTokens
+      }
+      && !evidence.runtimeRevision.isEmpty && !evidence.rationale.isEmpty
+      && !evidence.sources.isEmpty && evidence.sources.allSatisfy { $0.scheme == "https" }
+  }
+}
