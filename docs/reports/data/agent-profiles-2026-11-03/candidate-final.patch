new file mode 100644
index 0000000..61cb880
--- /dev/null
+++ b/Sources/SilliesReasoning/ConversationHistoryPreparation.swift
@@ -0,0 +1,66 @@
+import Foundation
+import SilliesCore
+
+/// Reads unsummarized history independently of the visible UI page. Only a prepared working set
+/// plus one bounded repository page is retained. The latest submitted turn is never summarized.
+struct ConversationHistoryPreparation {
+  let repository: any ConversationRepository
+  let manager: ConversationContextManager
+
+  func prepare(_ context: ChatContext) async throws -> ChatContext {
+    guard let handle = context.historyHandle, let current = context.messages.last else {
+      return try await manager.prepare(context)
+    }
+    var position: ConversationPageRequest.Position =
+      context.memory.throughMessageID.map {
+        .around($0)
+      } ?? .after(0)
+    var memory = context.memory
+    var pending: [ChatMessage] = []
+    var cursor: Int64?
+    while true {
+      try Task.checkCancellation()
+      let page = try await repository.page(.init(handle: handle, position: position))
+      guard let last = page.entries.last, cursor.map({ last.sequence > $0 }) ?? true else {
+        throw ConversationStorageError.changed
+      }
+      var entries = page.entries
+      if cursor == nil, let checkpoint = memory.throughMessageID {
+        guard entries.first?.id == checkpoint else { throw ConversationStorageError.changed }
+        entries.removeFirst()
+      }
+      if memory.throughMessageID == nil, memory.openingStatement.isEmpty,
+        let opening = entries.first(where: { $0.message.role == .user })
+      {
+        memory = .init(openingStatement: opening.message.text)
+      }
+      if let index = entries.firstIndex(where: { $0.id == current.id }) {
+        pending += entries[...index].map(\.message)
+        return try await manager.prepare(replacing(context, messages: pending, memory: memory))
+      }
+      pending += entries.map(\.message)
+      guard page.hasNewer else { throw ConversationStorageError.changed }
+      guard let user = pending.lastIndex(where: { $0.role == .user }) else {
+        throw ConversationStorageError.invalidData
+      }
+      let trailing = Array(pending.suffix(from: user + 1))
+      let prepared = try await manager.prepare(
+        replacing(context, messages: Array(pending[...user]), memory: memory))
+      memory = prepared.memory
+      pending = prepared.messages + trailing
+      cursor = last.sequence
+      position = .after(last.sequence)
+    }
+  }
+
+  private func replacing(
+    _ context: ChatContext, messages: [ChatMessage], memory: ConversationMemory
+  ) -> ChatContext {
+    .init(
+      companionName: context.companionName, profile: context.profile, messages: messages,
+      memory: memory
+    )
+    .inTurn(context.turnID, session: context.sessionID).inHistory(context.historyHandle)
+    .followingCheckpoint()
+  }
+}
