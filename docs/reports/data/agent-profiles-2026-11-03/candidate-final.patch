+import Foundation
+import SilliesCore
+import SilliesTextModels
+import Testing
+
+@testable import SilliesReasoning
+
+private actor GrowingMemoryBackend: ConversationBackend {
+  nonisolated let contextWindowTokens: Int
+  nonisolated let reasoningTokenReserve = 0
+  nonisolated var conversationPolicy: ConversationPolicy { AppleConversationPolicy.conversation }
+  nonisolated var generationProfile: TextGenerationProfile { AppleConversationPolicy.generation }
+  private(set) var summaryCalls = 0
+  init(capacity: Int = 2_048) { contextWindowTokens = capacity }
+  func availabilityNotice(localeIdentifier: String?) -> String? { nil }
+  func inputTokenCount(_ request: TextGenerationRequest) -> Int {
+    (request.instructions.utf8.count + request.messages.reduce(0) { $0 + $1.content.utf8.count })
+      / 4
+  }
+  func generate(_ request: TextGenerationRequest, format: ReasoningFormat) -> String {
+    summaryCalls += 1
+    return String(repeating: "The user owns the checklist. ", count: 40)
+  }
+  func converse(_ request: TextGenerationRequest, tools: ConversationToolbox) -> String { "Ready" }
+}
+
+@Test func replacementSummaryGrowthDoesNotTriggerRepeatedSummarization() async throws {
+  let backend = GrowingMemoryBackend()
+  let history =
+    (0..<20).flatMap { index in
+      [
+        ChatMessage(
+          role: .user, text: "Turn \(index). " + String(repeating: "Planning detail. ", count: 12)),
+        ChatMessage(role: .companion, text: String(repeating: "Discussed. ", count: 14)),
+      ]
+    } + [.init(role: .user, text: "What next?")]
+  let context = ChatContext(
+    companionName: "Pogo", profile: .init(personality: "Curious"), messages: history)
+  let manager = ConversationContextManager(backend: backend, tools: [], progress: { _ in })
+  let first = try await manager.prepare(context)
+  #expect(await backend.summaryCalls == 1)
+  #expect(!first.memory.summary.isEmpty)
+  #expect(first.messages.count > 1)
+  let continued = ChatContext(
+    companionName: "Pogo", profile: context.profile,
+    messages: history + [
+      .init(role: .companion, text: "Ready."), .init(role: .user, text: "Thanks!"),
+    ], memory: first.memory)
+  _ = try await manager.prepare(continued)
+  #expect(await backend.summaryCalls == 1)
+  #expect(history.count == 41)
+}
+
+@Test func fittingHistoryIsNotCompactedBecauseItCrossesAPagingTurnCount() async throws {
+  let backend = GrowingMemoryBackend(capacity: 16_384)
+  let messages =
+    (0..<40).flatMap { _ in
+      [
+        ChatMessage(role: .user, text: "A short detail"),
+        ChatMessage(role: .companion, text: "Understood"),
+      ]
+    } + [.init(role: .user, text: "Continue")]
+  let original = ChatContext(
+    companionName: "Pogo", profile: .init(personality: "Curious"), messages: messages)
+  let prepared = try await ConversationContextManager(
+    backend: backend, tools: [], progress: { _ in }
+  ).prepare(original)
+  #expect(prepared.messages == messages)
+  #expect(await backend.summaryCalls == 0)
+}
