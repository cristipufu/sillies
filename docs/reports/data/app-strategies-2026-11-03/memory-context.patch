+import SilliesCore
+
+/// A bounded local read supplies recent facts without asking the model to discover them first.
+struct ConversationMemoryPreparation {
+  let repository: (any CompanionMemoryRepository)?
+
+  func prepare(_ context: ChatContext) async throws -> ChatContext {
+    guard let repository, let handle = context.historyHandle else { return context }
+    try Task.checkCancellation()
+    let facts = try await repository.memories(handle, query: "")
+    try Task.checkCancellation()
+    return context.withSavedMemories(Array(facts.prefix(ConversationMemoryEvidence.resultLimit)))
+  }
+}
