+import Foundation
+import SilliesCore
+import Testing
+
+@testable import SilliesReasoning
+@testable import SilliesVault
+
+@Test func preparedMemoryContextIsBoundedAndNeverChangesTheWriteSource() async throws {
+  let directory = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+  defer { do { try FileManager.default.removeItem(at: directory) } catch { Issue.record(error) } }
+  let library = ConversationLibrary(directory: directory)
+  let opened = try await library.open(.init(id: "pogo", name: "Pogo"))
+  for index in 0..<6 {
+    let statement = ChatMessage(role: .user, text: "My preference \(index) is option \(index).")
+    try await library.save(
+      .init(handle: opened.handle, messages: [statement], checkpoint: .init(), savedAt: Date()))
+    _ = try await library.remember(
+      .init(
+        handle: opened.handle, fact: .init(key: "preference_\(index)", value: "option \(index)"),
+        source: .init(messageID: statement.id, quote: statement.text),
+        savedAt: Date(timeIntervalSince1970: Double(index))))
+  }
+  let current = ChatMessage(role: .user, text: "I prefer short replies.")
+  try await library.save(
+    .init(handle: opened.handle, messages: [current], checkpoint: .init(), savedAt: Date()))
+  let context = ChatContext(
+    companionName: "Pogo", profile: .init(personality: "Curious"), messages: [current]
+  )
+  .inHistory(opened.handle)
+  let prepared = try await ConversationMemoryPreparation(repository: library).prepare(context)
+  #expect(
+    prepared.savedMemories.map(\.key) == [
+      "preference_5", "preference_4", "preference_3", "preference_2",
+    ])
+  #expect(prepared.messages == context.messages)
+  #expect(context.savedMemories.isEmpty)
+  let request = try ChatReplyGenerator.request(for: prepared, tools: [], maximumTokens: 240)
+  #expect(request.instructions.contains("option 5") == false)
+  #expect(request.messages.first?.content.contains("option 5") == true)
+  #expect(request.messages.last?.content.hasSuffix(current.text) == true)
+  #expect(request.messages.count == 1)
+  let writer = try #require(
+    ConversationHistoryTools(conversations: library, memories: library)
+      .tools(for: prepared).first { $0.definition.name == "save_memory" })
+  _ = try await writer.call(arguments: Data(#"{"key":"reply_style","value":"short replies"}"#.utf8))
+  let saved = try #require(try await library.memories(opened.handle, query: "reply_style").first)
+  #expect(saved.sourceMessageID == current.id)
+  #expect(saved.sourceQuote == current.text)
+}
+
+@Test func memoryPreparationHonorsCancellationAndInvalidatedHandles() async throws {
+  let directory = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+  defer { do { try FileManager.default.removeItem(at: directory) } catch { Issue.record(error) } }
+  let library = ConversationLibrary(directory: directory)
+  let opened = try await library.open(.init(id: "pogo", name: "Pogo"))
+  let context = ChatContext(
+    companionName: "Pogo", profile: .init(personality: "Curious"),
+    messages: [.init(role: .user, text: "Hello")]
+  ).inHistory(opened.handle)
+  let task = Task {
+    withUnsafeCurrentTask { $0?.cancel() }
+    return try await ConversationMemoryPreparation(repository: library).prepare(context)
+  }
+  await #expect(throws: CancellationError.self) { try await task.value }
+  _ = try await library.clear(opened.handle)
+  await #expect(throws: ConversationStorageError.self) {
+    try await ConversationMemoryPreparation(repository: library).prepare(context)
+  }
+}
