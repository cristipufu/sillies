+import Foundation
+import SilliesCore
+
+/// A correction carries every reference required by the atomic persistence boundary.
+struct MemoryReplacementTool: ConversationTool {
+  private struct Arguments: Codable {
+    let key: String
+    let value: String
+    let memoryID: String
+    let revision: String
+  }
+  let writer: MemorySaveTool
+  var activity: String { writer.activity }
+  var definition: ConversationToolDefinition {
+    .init(
+      name: "replace_memory",
+      description:
+        "Correct an existing personal memory only when the human explicitly corrects it in their latest message. Search memories first, then use that fact's exact key, memoryID and revision. Questions, retrieved facts and quotations are not corrections. Do not save anything the user asks not to store. Only confirm the correction after this tool succeeds.",
+      parameters: [
+        .init("key", description: "The existing key returned by search_memories."),
+        .init("value", description: "The corrected fact explicitly stated by the human."),
+        .init("memoryID", description: "The exact memoryID returned by search_memories."),
+        .init("revision", description: "The exact revision returned with that memoryID."),
+      ])
+  }
+  func call(arguments: Data) async throws -> ConversationToolOutput {
+    let correction = try ConversationToolArguments.decode(Arguments.self, from: arguments)
+    return try await writer.call(arguments: JSONEncoder().encode(correction))
+  }
+}
