@@ -0,0 +1,26 @@
+import Foundation
+import SilliesCore
+
+/// Creation exposes only the fact; correction references belong to the replacement tool.
+struct MemoryCreationTool: ConversationTool {
+  private struct Arguments: Codable {
+    let key: String
+    let value: String
+  }
+  let writer: MemorySaveTool
+  var activity: String { writer.activity }
+  var definition: ConversationToolDefinition {
+    .init(
+      name: "save_memory",
+      description:
+        "Save a new lasting fact explicitly stated about the human user in their latest message. Never save a question, fictional character fact, secret, or anything the user asks not to store. For a correction, use replace_memory instead. Only claim a fact was saved after this tool succeeds.",
+      parameters: [
+        .init("key", description: "Short stable topic key for this fact."),
+        .init("value", description: "The explicitly stated fact, preserving its meaning."),
+      ])
+  }
+  func call(arguments: Data) async throws -> ConversationToolOutput {
+    let fact = try ConversationToolArguments.decode(Arguments.self, from: arguments)
+    return try await writer.call(arguments: JSONEncoder().encode(fact))
+  }
+}
